# Supply-chain hardening (project.md SC-47).
#
# Dependency lifecycle scripts (preinstall/install/postinstall) are disabled by
# default so a malicious transitive package cannot execute code during
# `pnpm install`. pnpm additionally gates native build scripts behind an
# explicit allowlist declared in package.json under `pnpm.onlyBuiltDependencies`
# (currently empty). Adding an entry requires a PR justification and
# security-engineer review (SC-46).
ignore-scripts=true

# Refuse to run under a package manager other than the pinned one.
engine-strict=true
